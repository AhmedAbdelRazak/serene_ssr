# Public runtime (safe for browser exposure)
NEXT_PUBLIC_MAIN_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXT_PUBLIC_API_URL_MAIN=https://api.your-domain.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id
NEXT_PUBLIC_GOOGLE_ANALYTICS_MEASUREMENTID=G-XXXXXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=123456789012345

# Optional public IDs (never place server secrets in NEXT_PUBLIC vars)
NEXT_PUBLIC_SQUARE_APPLICATION_ID_TEST=
NEXT_PUBLIC_SQUARE_LOCATION_ID_TEST=

# Server-only values should NOT use NEXT_PUBLIC_
# Example:
# GOOGLE_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# PRINTIFY_TOKEN=

